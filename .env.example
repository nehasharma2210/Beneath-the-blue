# Environment Variables for Beneath the Blue
# Copy this file to .env and fill in your actual values

# Django Settings
SECRET_KEY=your-secret-key-here-generate-a-new-one-for-production
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# Database (for production deployment)
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Email Configuration
EMAIL_PASSWORD=your-16-digit-app-password

# Logging
DJANGO_LOG_LEVEL=INFO

# For Render deployment, add these as environment variables in Render dashboard:
# - SECRET_KEY
# - DEBUG (set to False)
# - ALLOWED_HOSTS (set to your-app-name.onrender.com)
# - DATABASE_URL (will be automatically provided by Render if you add a PostgreSQL database)
